// UDGOK CMS v1 schema
// See docs/superpowers/specs/2026-08-16-handoff-cms-slice-b-design.md section 2 for full spec.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================
// AUTH-SYNCED FROM CLERK (via webhooks)
// Never write to these directly.
// =========================================

model Workspace {
  id        String   @id // == Clerk organization ID
  name      String
  slug      String   @unique
  industry  String?
  plan      Plan     @default(STARTER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  Membership[]
  clients  Client[]
  deals    Deal[]
  projects Project[]
  tasks    Task[]
  files    File[]
  teams    Team[]
  subs     Subcontractor[]
  activity ActivityLog[]
  messages Message[]
  projectPhotos ProjectPhoto[]
  permits       Permit[]
  photoFolders  ProjectPhotoFolder[]
  inspections   Inspection[]

  @@index([slug])
}

model User {
  id        String   @id // == Clerk user ID
  email     String   @unique
  name      String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships    Membership[]
  notes          Note[]
  uploads        File[]          @relation("uploader")
  assignedTasks  Task[]          @relation("assignee")
  createdTasks   Task[]          @relation("creator")
  messages       Message[]
  projectPhotos  ProjectPhoto[]
  projectMembers ProjectMember[]
  teamMembers    TeamMember[]
  activity       ActivityLog[]

  @@index([email])
}

model Membership {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String
  role        Role     @default(MEMBER)
  joinedAt    DateTime @default(now())

  // Presence tracking — updated by the /api/presence/heartbeat route.
  // A member is "online" if lastSeenAt is within the past 5 minutes
  // and "idle" if within 60 minutes. Anything older is offline.
  lastSeenAt  DateTime?
  isOnline    Boolean   @default(false)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@index([workspaceId, isOnline])
}

enum Role {
  OWNER
  ADMIN
  PM
  ESTIMATOR
  FIELD
  MEMBER
}

// Subscription tiers. Used to gate premium features across the app.
// When you wire this to Clerk billing later, the `plan` field will be
// synced from the Clerk subscription; the feature flag check
// (lib/workspace/tier.ts) stays the same.
enum Plan {
  STARTER
  PRO
  ENTERPRISE
}

// Entity types a Message can be attached to. We deliberately use a
// small set (no file, no task — too many touch points) so the messages
// UI stays simple. The polymorphic (entityType, entityId) pair points
// at the relevant record; this avoids N junction tables.
enum MessageEntityType {
  PROJECT
  CLIENT
  DEAL
  SUBCONTRACTOR
  PAY_APP
  WORKSPACE
}

// =========================================
// CRM
// =========================================

model Client {
  id          String       @id @default(cuid())
  workspaceId String
  name        String
  email       String?
  phone       String?
  type        ClientType   @default(RESIDENTIAL)
  status      ClientStatus @default(ACTIVE)
  source      String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  properties Property[]
  deals      Deal[]
  projects   Project[]
  tasks      Task[]
  notes      Note[]
  files      File[]

  @@index([workspaceId, status])
  @@index([workspaceId, name])
}

enum ClientType {
  RESIDENTIAL
  COMMERCIAL
  PROPERTY_MANAGER
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model Property {
  id        String  @id @default(cuid())
  clientId  String
  label     String
  address   String
  city      String
  state     String
  zip       String
  yearBuilt Int?
  sqft      Int?
  notes     String?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  deals  Deal[]

  @@index([clientId])
}

model Deal {
  id            String    @id @default(cuid())
  workspaceId   String
  clientId      String
  propertyId    String?
  title         String
  description   String?
  stage         DealStage @default(LEAD)
  value         Decimal   @db.Decimal(12, 2)
  margin        Float?
  expectedClose DateTime?
  closedAt      DateTime?
  fitScore      Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client    Client    @relation(fields: [clientId], references: [id])
  property  Property? @relation(fields: [propertyId], references: [id])
  notes     Note[]
  files     File[]
  tasks     Task[]

  @@index([workspaceId, stage])
  @@index([workspaceId, clientId])
}

enum DealStage {
  LEAD
  CONTACTED
  ESTIMATE_SENT
  NEGOTIATING
  WON
  LOST
}

model Note {
  id        String   @id @default(cuid())
  authorId  String
  body      String
  clientId  String?
  dealId    String?
  projectId String?
  createdAt DateTime @default(now())

  author  User     @relation(fields: [authorId], references: [id])
  client  Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  deal    Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([dealId])
  @@index([projectId])
}

// =========================================
// PROJECTS (core in v1; full pay app in v1 too)
// =========================================

model Project {
  id            String        @id @default(cuid())
  workspaceId   String
  clientId      String?
  name          String
  code          String?
  description   String?
  status        ProjectStatus @default(ACTIVE)
  startDate     DateTime?
  endDate       DateTime?
  contractValue Decimal?      @db.Decimal(12, 2)
  address       String?
  city          String?
  state         String?
  zip           String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client    Client?           @relation(fields: [clientId], references: [id])
  members   ProjectMember[]
  tasks     Task[]
  files     File[]
  notes     Note[]
  divisions ProjectDivision[]
  payApps   PayApp[]
  subAssignments ProjectSubcontractorAssignment[]
  photos    ProjectPhoto[]
  photoFolders ProjectPhotoFolder[]
  permits   Permit[]

  @@index([workspaceId, status])
  @@index([workspaceId, clientId])
}

// Per-construction-phase photos. Categorized by:
//   - room (free text: "Kitchen", "Master Bath", "Lobby")
//   - area (free text: "North wing", "Floor 2")
//   - phase: ROUGH_IN (framing/electrical/plumbing before drywall)
//          or FINAL (completed work, post-drywall/paint/finish)
//
// Foremen can snap a "rough-in" photo at the right phase and the
// project owner sees it instantly. The "phase" toggle in the gallery
// filters to just rough-in or just final photos, so you can compare
// before/after.
model ProjectPhotoFolder {
  id          String   @id @default(cuid())
  workspaceId String
  projectId   String
  name        String   // e.g. "Punch List", "Before", "Foundation", "MEP"
  description String?
  color       String   @default("orange") // css color name: orange, ink, success, etc.
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  photos    ProjectPhoto[]

  @@index([projectId, sortOrder])
  @@unique([projectId, name])
}

model ProjectPhoto {
  id          String        @id @default(cuid())
  workspaceId String
  projectId   String
  uploaderId  String
  folderId    String?
  url         String        // Vercel Blob URL
  filename    String
  mimeType    String
  size        Int
  room        String?       // e.g. "Kitchen", "Master Bath"
  area        String?       // e.g. "North wing", "Floor 2"
  phase       PhotoPhase    @default(ROUGH_IN)
  caption     String?
  latitude    Float?
  longitude   Float?
  takenAt     DateTime?
  createdAt   DateTime      @default(now())

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader  User                @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  folder    ProjectPhotoFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([projectId, phase, createdAt])
  @@index([projectId, room])
  @@index([workspaceId, createdAt])
}

enum PhotoPhase {
  ROUGH_IN
  FINAL
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

// =========================================
// PERMITS & INSPECTIONS
// =========================================

enum PermitStatus {
  NOT_APPLIED
  APPLIED
  ISSUED
  INSPECTION_SCHEDULED
  PASSED
  FAILED
  EXPIRED
  CANCELLED
}

enum InspectionType {
  // Pre-cover / structural
  FOOTING
  FOUNDATION
  SLAB
  // Framing
  FRAMING
  SHEATHING
  // MEP rough
  ROUGH_PLUMBING
  ROUGH_ELECTRICAL
  ROUGH_MECHANICAL
  ROUGH_GAS
  // Insulation / drywall
  INSULATION
  DRYWALL
  // Exterior
  ROOFING
  WINDOW
  SIDING
  // Final
  FINAL_PLUMBING
  FINAL_ELECTRICAL
  FINAL_MECHANICAL
  FINAL_BUILDING
  // Specialty
  FIRE
  UTILITY
  CUSTOM
}

enum InspectionResult {
  PENDING
  PASSED
  FAILED
  PARTIAL
  CANCELLED
}

model Permit {
  id            String       @id @default(cuid())
  workspaceId   String
  projectId     String
  permitNumber  String?      // e.g. "BLD-2026-04812"
  type          String       // e.g. "Building", "Electrical", "Plumbing", "Mechanical", "Demolition"
  status        PermitStatus @default(NOT_APPLIED)
  jurisdiction  String?      // e.g. "City of Tulsa", "City of Austin"
  appliedDate   DateTime?
  issuedDate    DateTime?
  expirationDate DateTime?
  fee           Decimal?     @db.Decimal(10, 2)
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  inspections Inspection[]

  @@index([projectId])
  @@index([workspaceId])
  @@index([status])
}

model Inspection {
  id             String           @id @default(cuid())
  workspaceId    String
  permitId       String
  type           InspectionType
  scheduledDate  DateTime?
  result         InspectionResult @default(PENDING)
  inspectorName  String?
  scheduledBy    String?          // e.g. "Foreman Bob", "PM Sarah"
  notes          String?
  completedDate  DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  permit    Permit    @relation(fields: [permitId], references: [id], onDelete: Cascade)

  @@index([permitId])
  @@index([scheduledDate])
  @@index([result])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String?
  joinedAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
}

// =========================================
// TASKS
// =========================================

model Task {
  id          String       @id @default(cuid())
  workspaceId String
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(NORMAL)
  dueDate     DateTime?
  startDate   DateTime?
  endDate     DateTime?
  assigneeId  String?
  createdById String
  clientId    String?
  dealId      String?
  projectId   String?
  taskId      String? // for sub-tasks
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignee  User?     @relation("assignee", fields: [assigneeId], references: [id])
  createdBy User      @relation("creator", fields: [createdById], references: [id])
  client    Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  deal      Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parent    Task?     @relation("subtasks", fields: [taskId], references: [id], onDelete: SetNull)
  subtasks  Task[]    @relation("subtasks")
  files     File[]    @relation("taskFiles")

  @@index([workspaceId, status])
  @@index([workspaceId, assigneeId])
  @@index([workspaceId, dueDate])
  @@index([workspaceId, projectId])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// =========================================
// FILES / DOCUMENTS
// =========================================

model File {
  id          String   @id @default(cuid())
  workspaceId String
  uploaderId  String
  url         String
  filename    String
  mimeType    String
  size        Int
  kind        FileKind @default(DOCUMENT)
  category    String?
  clientId    String?
  dealId      String?
  projectId   String?
  taskId      String?
  // GPS coordinates captured at upload time. Used for "GPS-tagged site
  // photos" feature — lets you see exactly where on the job site a
  // photo was taken.
  latitude   Float?
  longitude  Float?
  takenAt    DateTime?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploader  User      @relation("uploader", fields: [uploaderId], references: [id])
  client    Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  deal      Deal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task      Task?     @relation("taskFiles", fields: [taskId], references: [id], onDelete: Cascade)

  @@index([workspaceId, kind])
  @@index([workspaceId, category])
  @@index([clientId])
  @@index([dealId])
  @@index([projectId])
  @@index([taskId])
}

enum FileKind {
  DOCUMENT
  PHOTO
  FLOORPLAN
  CONTRACT
  INVOICE
  OTHER
}

// =========================================
// PAY APPS (full workflow in v1)
// =========================================

model ProjectDivision {
  id                String   @id @default(cuid())
  projectId         String
  code              String
  trade             String
  subcontractorName String?
  budget            Decimal  @db.Decimal(12, 2)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  payAppLines PayAppDivision[]
  subLinks    ProjectDivisionAssignment[]

  @@index([projectId, sortOrder])
}

model PayApp {
  id             String       @id @default(cuid())
  projectId      String
  drawNumber     Int
  periodStart    DateTime
  periodEnd      DateTime
  status         PayAppStatus @default(DRAFT)
  totalContract  Decimal      @db.Decimal(12, 2)
  totalPrevious  Decimal      @db.Decimal(12, 2)
  totalThisDraw  Decimal      @db.Decimal(12, 2)
  totalBalance   Decimal      @db.Decimal(12, 2)
  notes          String?
  pdfUrl         String?
  shareToken     String       @unique
  sentAt         DateTime?
  sentToEmail    String?
  acknowledgedAt DateTime?
  firstViewedAt  DateTime?
  viewCount      Int          @default(0)
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  divisions  PayAppDivision[]
  viewEvents PayAppViewEvent[]

  @@unique([projectId, drawNumber])
  @@index([projectId, status])
  @@index([shareToken])
}

enum PayAppStatus {
  DRAFT
  SENT
  VIEWED
  ACKNOWLEDGED
  PAID
  DISPUTED
  SUPERSEDED
}

model PayAppDivision {
  id                String  @id @default(cuid())
  payAppId          String
  projectDivisionId String
  previousAmount    Decimal @db.Decimal(12, 2)
  thisDrawAmount    Decimal @db.Decimal(12, 2)
  balanceAfter      Decimal @db.Decimal(12, 2)
  sortOrder         Int

  payApp          PayApp          @relation(fields: [payAppId], references: [id], onDelete: Cascade)
  projectDivision ProjectDivision @relation(fields: [projectDivisionId], references: [id])

  @@index([payAppId])
}

model PayAppViewEvent {
  id          String   @id @default(cuid())
  payAppId    String
  viewedAt    DateTime @default(now())
  viewerEmail String?
  ipAddress   String?
  userAgent   String?
  referrer    String?

  payApp PayApp @relation(fields: [payAppId], references: [id], onDelete: Cascade)

  @@index([payAppId, viewedAt])
}

// =========================================
// TEAMS (sub-groups within a workspace)
// "Field Crew", "Estimators", "Project Managers"
// =========================================

model Team {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  color       String   @default("#f06a2d") // UDGOK orange default
  icon        String   @default("👥")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members   TeamMember[]

  @@index([workspaceId])
}

model TeamMember {
  id     String   @id @default(cuid())
  teamId String
  userId String
  role   TeamRole @default(MEMBER)
  joinedAt DateTime @default(now())

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

enum TeamRole {
  LEAD
  MEMBER
}

// =========================================
// SUBCONTRACTORS
// Library of subs (separate from Clients — subs are vendors).
// Can be assigned to projects and to specific SOV divisions.
// =========================================

model Subcontractor {
  id              String    @id @default(cuid())
  workspaceId     String
  name            String
  primaryTrade    String?   // primary CSI division (e.g. "06", "22", "23")
  contactName     String?
  contactEmail    String?
  contactPhone    String?
  address         String?
  licenseNumber   String?
  insuranceExpiry DateTime?
  w9OnFile        Boolean   @default(false)
  hourlyRate      Decimal?  @db.Decimal(10, 2)
  notes           String?
  rating          Int?      // 1–5 self-rated quality
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace   Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignments ProjectSubcontractorAssignment[]

  @@index([workspaceId, name])
  @@index([workspaceId, primaryTrade])
}

model ProjectSubcontractorAssignment {
  id              String                 @id @default(cuid())
  projectId       String
  subcontractorId String
  contractAmount  Decimal                @default(0) @db.Decimal(12, 2)
  status          SubcontractorStatus    @default(PROPOSED)
  notes           String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  project       Project                       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subcontractor Subcontractor                 @relation(fields: [subcontractorId], references: [id])
  divisionLinks ProjectDivisionAssignment[]

  @@index([projectId])
  @@index([subcontractorId])
}

enum SubcontractorStatus {
  PROPOSED
  CONTRACTED
  ACTIVE
  COMPLETED
  CANCELLED
}

// Links an assignment to specific SOV divisions.
// One assignment can cover N divisions, and each division has a dollar amount
// allocated to that sub (so the SOV can show "Site prep: $5,000 (Acme Concrete)").
model ProjectDivisionAssignment {
  id           String  @id @default(cuid())
  assignmentId String
  divisionId   String
  amount       Decimal @default(0) @db.Decimal(12, 2)

  assignment ProjectSubcontractorAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  division   ProjectDivision                @relation(fields: [divisionId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, divisionId])
  @@index([divisionId])
}

// =========================================
// ACTIVITY LOG
// Universal audit trail: who did what to which entity, when.
// Used for the per-entity History tab AND the workspace-wide Activity page.
// =========================================

model ActivityLog {
  id          String   @id @default(cuid())
  workspaceId String
  actorId     String?  // null for system events (auto-views, etc.)
  action      String   // 'created' | 'updated' | 'deleted' | 'sent' | 'viewed' | 'acknowledged' | 'paid' | 'disputed' | 'assigned' | 'unassigned' | 'invited' | 'joined'
  entityType  String   // 'client' | 'project' | 'pay_app' | 'subcontractor' | 'task' | 'team' | 'workspace' | 'member' | 'note' | 'file' | 'division'
  entityId    String
  entityName  String?  // Human-readable name for display (denormalized for fast read)
  details     String?  // One-line summary e.g. "Bob added $5,000 to Site prep"
  metadata    Json?    // Optional structured data (changed fields, etc.)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, entityType, entityId])
  @@index([actorId, createdAt])
}

// Per-entity comment threads. The (entityType, entityId) pair points at
// the record the thread is attached to (project, client, deal, etc.).
// threadId groups replies together — top-level messages have
// threadId == id, replies have threadId pointing at the root.
// This is the team's "internal messages" feature. Each entity gets its
// own channel; no DM-style messaging for v1.
model Message {
  id          String            @id @default(cuid())
  workspaceId String
  authorId    String
  body        String
  entityType  MessageEntityType
  entityId    String
  threadId    String?           // null = top-level; otherwise = root message id
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  editedAt    DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([workspaceId, entityType, entityId, createdAt])
  @@index([threadId, createdAt])
  @@index([authorId, createdAt])
}
