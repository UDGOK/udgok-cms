  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  payAppLines PayAppDivision[]
  subLinks    ProjectDivisionAssignment[]

  @@index([projectId, sortOrder])
}

model PayApp {
  id             String       @id @default(cuid())
  projectId      String
  drawNumber     Int
  periodStart    DateTime
  periodEnd      DateTime
  status         PayAppStatus @default(DRAFT)
  totalContract  Decimal      @db.Decimal(12, 2)
  totalPrevious  Decimal      @db.Decimal(12, 2)
  totalThisDraw  Decimal      @db.Decimal(12, 2)
  totalBalance   Decimal      @db.Decimal(12, 2)
  notes          String?
  pdfUrl         String?
  shareToken     String       @unique
  sentAt         DateTime?
  sentToEmail    String?
  acknowledgedAt    DateTime?
  acknowledgedByEmail String?
  acknowledgedByName  String?
  firstViewedAt  DateTime?
  viewCount      Int          @default(0)
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  divisions  PayAppDivision[]
  viewEvents PayAppViewEvent[]

