// =========================================
// SUBCONTRACTORS
// Library of subs (separate from Clients — subs are vendors).
// Can be assigned to projects and to specific SOV divisions.
// =========================================

model Subcontractor {
  id              String    @id @default(cuid())
  workspaceId     String
  name            String
  primaryTrade    String? // primary CSI division (e.g. "06", "22", "23")
  contactName     String?
  contactEmail    String?
  contactPhone    String?
  address         String?
  licenseNumber   String?
  insuranceExpiry DateTime?
  w9OnFile        Boolean   @default(false)
  w9ScannedAt     DateTime? // when the W-9 photo was last uploaded
  idScanned       Boolean   @default(false) // true after the sub's ID card has been scanned
  idScannedAt     DateTime? // when the ID card photo was last uploaded
  hourlyRate      Decimal?  @db.Decimal(10, 2)
  notes           String?
  rating          Int? // 1–5 self-rated quality
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace     Workspace                        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignments   ProjectSubcontractorAssignment[]
  documents     File[]                           @relation("subcontractorDocuments")
  checkInEvents CheckInEvent[]                   @relation("checkInSubcontractor")

  @@index([workspaceId, name])
  @@index([workspaceId, primaryTrade])
}

model ProjectSubcontractorAssignment {
  id              String              @id @default(cuid())
  projectId       String
  subcontractorId String
  contractAmount  Decimal             @default(0) @db.Decimal(12, 2)
  status          SubcontractorStatus @default(PROPOSED)
  notes           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  project       Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subcontractor Subcontractor               @relation(fields: [subcontractorId], references: [id], onDelete: Cascade)
  divisionLinks ProjectDivisionAssignment[]

  @@index([projectId])
  @@index([subcontractorId])
}

enum SubcontractorStatus {
  PROPOSED
  CONTRACTED
  ACTIVE
  COMPLETED
  CANCELLED
}

// Links an assignment to specific SOV divisions.
// One assignment can cover N divisions, and each division has a dollar amount
// allocated to that sub (so the SOV can show "Site prep: $5,000 (Acme Concrete)").
model ProjectDivisionAssignment {
  id           String  @id @default(cuid())
  assignmentId String
  divisionId   String
  amount       Decimal @default(0) @db.Decimal(12, 2)

  assignment ProjectSubcontractorAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  division   ProjectDivision                @relation(fields: [divisionId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, divisionId])
  @@index([divisionId])
}

// =========================================
// ACTIVITY LOG
// Universal audit trail: who did what to which entity, when.
// Used for the per-entity History tab AND the workspace-wide Activity page.
// =========================================

model ActivityLog {
  id          String   @id @default(cuid())
  workspaceId String
  actorId     String? // null for system events (auto-views, etc.)
  action      String // 'created' | 'updated' | 'deleted' | 'sent' | 'viewed' | 'acknowledged' | 'paid' | 'disputed' | 'assigned' | 'unassigned' | 'invited' | 'joined'
  entityType  String // 'client' | 'project' | 'pay_app' | 'subcontractor' | 'task' | 'team' | 'workspace' | 'member' | 'note' | 'file' | 'division'
  entityId    String
  entityName  String? // Human-readable name for display (denormalized for fast read)
  details     String? // One-line summary e.g. "Bob added $5,000 to Site prep"
  metadata    Json? // Optional structured data (changed fields, etc.)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, entityType, entityId])
  @@index([actorId, createdAt])
}

// Per-entity comment threads. The (entityType, entityId) pair points at
// the record the thread is attached to (project, client, deal, etc.).
// threadId groups replies together — top-level messages have
// threadId == id, replies have threadId pointing at the root.
// This is the team's "internal messages" feature. Each entity gets its
// own channel; no DM-style messaging for v1.
model Message {
  id          String            @id @default(cuid())
  workspaceId String
  authorId    String
  body        String
  entityType  MessageEntityType
  entityId    String
  threadId    String? // null = top-level; otherwise = root message id
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  editedAt    DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([workspaceId, entityType, entityId, createdAt])
  @@index([threadId, createdAt])
  @@index([authorId, createdAt])
}

// =========================================
// BIM TAKEOFF
// =========================================

// One IFC/BIM file uploaded to the project. The .ifc lives in Vercel
// Blob; this row is the metadata. Uploader FK is NoAction (matches
// the pattern we set after the deleteWorkspace saga — a user with
// models uploaded must not block a user delete).
model BimModel {
  id          String   @id @default(cuid())
  projectId   String
  workspaceId String
  uploaderId  String
  url         String // Vercel Blob URL of the .ifc file
  filename    String
  size        Int
  createdAt   DateTime @default(now())

  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploader  User         @relation("bimUploader", fields: [uploaderId], references: [id], onDelete: NoAction)
  takeoffs  BimTakeoff[]

  @@index([projectId])
  @@index([workspaceId])
}

// One takeoff run against a BimModel. The result is the raw JSON
// the Python service returned, schema-documented in lib/takeoff/types.ts
// (see TakeoffResult). Storing it as Json lets the service evolve
// without a Prisma migration.
model BimTakeoff {
  id          String        @id @default(cuid())
  bimModelId  String
  projectId   String
  workspaceId String
  status      TakeoffStatus @default(PENDING)
  // Full JSON payload from the service. Keep as Json so the service
  // can evolve the TakeoffResult shape without a migration.
  result      Json?
  error       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  bimModel  BimModel  @relation(fields: [bimModelId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([bimModelId])
  @@index([status])
}

enum TakeoffStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

// =========================================
// SITE CHECK-IN / CHECK-OUT (QR codes)
// =========================================

// One per project, optionally more. A project can have
// multiple "check-in points" (e.g. "main gate", "shop
// entrance", "north laydown"). Each SiteCheckInCode row
// is one printable QR sticker that an employee or sub
// scans to check in / out.
//
// The QR encodes a public URL of the form /c/<token>.
// The token is the credential: anyone with the sticker
// can scan it, and the system trusts the on-site phone
// to attribute the scan.
//
// isActive is a soft-disable so an admin can retire a
// sticker without breaking the FK chain on a CheckInEvent
// that points at it. Existing rows still resolve; new
// scans reject.
model SiteCheckInCode {
  id          String   @id @default(cuid())
  workspaceId String
  projectId   String
  // Optional friendly label so the admin can tell them
  // apart ("main gate", "shop door", etc.). Uniqueness
  // is per-project, not per-workspace.
  label       String   @default("Main entrance")
  // The random token encoded in the QR. Unique. Used in
  // the public scan URL so the public route can resolve
  // back to a project without revealing the project id.
  token       String   @unique
  createdById String
  // Soft-disable so an admin can retire a sticker without
  // breaking the FK chain on a CheckInEvent that points at
  // it. Existing rows still resolve; new scans reject.
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy     User           @relation("siteCheckInCodeCreator", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: Cascade)
  checkInEvents CheckInEvent[]

  @@index([workspaceId, projectId])
  @@index([token])
}

// One row per check-in event. Closed on check-out.
// Either the signed-in workspace member (employee) or the
// subcontractor (foreman) starts the entry.
//
// Geolocation at check-in time is captured if the user
// grants permission — the browser asks, we don't block
// the scan if the user denies.
//
// We deliberately do NOT link ScanEvent to CheckInEvent
// with an FK: ScanEvent is the universal audit log, and
// a single orphan check-in should not break the chain.
// The check-in page writes its own ScanEvent via the
// existing ScanEvent.create path (matched: 'checkin',
// matchedId: siteCheckInCodeId).
model CheckInEvent {
  id                String    @id @default(cuid())
  workspaceId       String
  siteCheckInCodeId String
  projectId         String
  // The "who" — exactly one of these two is set. The
  // signed-in user can always be inferred from the Clerk
  // session; the sub is selected from a list at check-in
  // time (since subs don't sign in to the CMS).
  userId            String?
  subcontractorId   String?
  // Open until checked out.
  checkedInAt       DateTime  @default(now())
  checkedOutAt      DateTime?
  // Optional note for the visit (e.g. "delivering tile",
  // "rough-in inspection").
  note              String?
  // Geolocation at check-in time, if the user grants
  // permission. The browser asks for it; we don't block
  // the scan if the user denies.
  checkInLat        Float?
  checkInLng        Float?
  checkOutLat       Float?
  checkOutLng       Float?

  // =========================================
  // Hours-tracking admin overrides
  // =========================================
  // An admin (OWNER/ADMIN/PM) can manually adjust the
  // hours on a closed event. The original timestamps
  // (checkedInAt / checkedOutAt) stay intact for
  // audit; effective hours = editedHours ?? (out - in).
  //
  // Why a separate field instead of editing the
  // timestamps directly:
  //   1. Audit — we keep the "what the system recorded"
  //      vs "what the admin says" split, so a later
  //      reviewer can see both.
  //   2. Edge cases — foremen forget to clock out for
  //      lunch; the system records checkedInAt at 7am
  //      and checkedOutAt at 5pm (8 hours wall clock)
  //      but the real working time was 7 hours. The
  //      admin sets editedHours=7 with a note
  //      "forgot to clock out for lunch".
  editedHours Decimal?  @db.Decimal(8, 2)
  // The admin who made the override + when.
  editedById  String?
  editedAt    DateTime?
  // Required when editedHours is set. Audit context
  // for why the override was made.
  editNote    String?

  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  siteCheckInCode SiteCheckInCode @relation(fields: [siteCheckInCodeId], references: [id], onDelete: Cascade)
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user            User?           @relation("checkInUser", fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  subcontractor   Subcontractor?  @relation("checkInSubcontractor", fields: [subcontractorId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  editedBy        User?           @relation("checkInEditor", fields: [editedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([workspaceId, projectId, checkedInAt])
  @@index([workspaceId, checkedInAt])
  @@index([subcontractorId, checkedInAt])
  @@index([userId, checkedInAt])
  @@index([siteCheckInCodeId, checkedInAt])
}

// =========================================
// TIMESHEET APPROVALS — per-week lockable state
// =========================================
//
// One row per (workspace, person, week). The
// "person" is either a workspace member (employee)
// or a subcontractor. A timesheet starts in DRAFT
// and moves through SUBMITTED → APPROVED | REJECTED
// via the actions in lib/timesheets/approvals.ts.
//
// Why a separate table (not a column on CheckInEvent):
//   1. The lock is on the WEEK, not on individual
//      events. A single week can contain N events.
//   2. The submitter + approver + timestamps are
//      audit context that doesn't belong on a
//      per-event row.
//   3. The "submitted" / "approved" state needs to
//      be queried independently of the events
//      (for the approvals list, the lock check, etc.).
//
// Lock semantics: when status = APPROVED, edits to
// events within that week are blocked at the action
// layer. Unlock moves it back to DRAFT with an audit
// row (so we know who unlocked + why).

model WeeklyTimesheet {
  id          String   @id @default(cuid())
  workspaceId String
  // "employee" or "sub". We store as a string for
  // forward-compat — adding a new person kind (e.g.
  // "owner" for a one-person consultancy) doesn't
  // require a schema migration.
  personKind  String
  // For employees: userId. For subs: subcontractorId.
  // The action layer enforces the right-of-existence
  // (i.e. the row must reference a real user or sub
  // in this workspace).
  personId    String
  // The Monday 00:00 UTC of the week this row
  // represents. We always store the Monday (never a
  // midweek date) so the (workspace, person, weekStart)
  // unique constraint is meaningful.
  weekStart   DateTime

  status WeeklyTimesheetStatus @default(DRAFT)

  // Submission audit
  submittedById        String?
  submittedAt          DateTime?
  // Approval audit
  approvedById         String?
  approvedAt           DateTime?
  // Rejection (note is required for rejection)
  rejectedById         String?
  rejectedAt           DateTime?
  rejectNote           String?
  // The total hours at the moment of approval —
  // captures the snapshot so a later edit (after
  // unlock) can show "approved at 47.5h, now 51h".
  totalHoursAtApproval Decimal?  @db.Decimal(8, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  submittedBy User?     @relation("timesheetSubmitter", fields: [submittedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  approvedBy  User?     @relation("timesheetApprover", fields: [approvedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  rejectedBy  User?     @relation("timesheetRejecter", fields: [rejectedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([workspaceId, personKind, personId, weekStart])
  @@index([workspaceId, status])
  @@index([workspaceId, weekStart, status])
  @@index([submittedById])
  @@index([approvedById])
}

enum WeeklyTimesheetStatus {
  // Default state. The timesheet is open for
  // edits and submissions. Anyone with edit
  // permission can change the underlying
  // events freely.
  DRAFT
  // Submitter signed off; awaiting approver
  // review. Edits to the events are still
  // allowed but warn the user that the timesheet
  // is mid-flight.
  SUBMITTED
  // Approver signed off. The timesheet is
  // LOCKED — events cannot be edited without
  // an explicit unlock.
  APPROVED
  // Approver rejected the submission. The
  // submitter can edit and resubmit. The
  // rejectNote tells them why.
  REJECTED
}

// =========================================
// NOTIFICATIONS — per-user bell inbox
// =========================================
//
// One row per (recipient, event). When a team leader
// broadcasts an alert, the push action fans out into
// N rows — one per recipient. The bell dropdown reads
// from the recipient's own rows only.
//
// Why fan-out instead of a single "broadcast" row with
// a recipients join table:
//   - per-recipient read/dismiss state without a join
//   - simple "unread count for me" query (no join)
//   - simple "mark all read" for a single recipient
//   - the cost is acceptable: a 10-person workspace
//     broadcasts to 10 rows, not 1
//
// The cost ceiling is fine even at 100-person orgs:
// 1 broadcast = 100 rows, not 1,000,000. At our scale
// (small construction teams) this is noise.

model Notification {
  id          String  @id @default(cuid())
  workspaceId String
  recipientId String
  // null = system-generated (auto-events from check-ins
  // etc.). Non-null = a workspace member pushed the
  // alert through the compose modal.
  createdById String?

  // Type — the broad bucket. Used to pick the icon
  // shown in the bell dropdown and the colour of the
  // row. Examples:
  //   "team_push"     — leader sent an alert
  //   "checkin"       — someone checked in to a project
  //   "pay_app"       — pay app status change
  //   "task"          — task assigned / status changed
  //   "project"       — project created / updated
  //   "system"        — generic system message
  type String

  // Category — secondary grouping for filters. Same
  // values as type for v1, but kept separate so we can
  // later split "all project events" without renaming
  // the type field.
  category String

  // Title is the bold line in the bell dropdown. Short
  // — one line. Body is the lighter secondary line;
  // can be 1-2 sentences. Both are required for human
  // pushes; body is optional for system events.
  title String
  body  String?

  // Optional URL to navigate to when the user clicks
  // the notification. Workspace-relative, e.g.
  // "/w/udgok/projects/cmt..." or "/w/udgok/team".
  // When null, clicking the row just marks it read.
  link String?

  createdAt   DateTime  @default(now())
  // null until the user clicks the row OR explicitly
  // hits "mark all read". Distinct from dismissedAt —
  // a read notification can still be dismissed later
  // (e.g. user wants to clear the panel after reading
  // everything).
  readAt      DateTime?
  // null until the user clicks the × button or the
  // row's dismiss action. Dismissed rows are hidden
  // from the panel entirely (the "see all" link can
  // still show them with a filter).
  dismissedAt DateTime?

  // Optional metadata. Stored as JSON string for
  // flexibility — typed on the read side via
  // lib/notifications/types.ts. Examples:
  //   { projectId: "..." } for project-scoped notifs
  //   { checkInEventId: "..." } for check-in notifs
  //   { payAppId: "..." } for pay-app notifs
  metadata String?

  workspace Workspace @relation("notificationWorkspace", fields: [workspaceId], references: [id], onDelete: Cascade)
  recipient User      @relation("notificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("notificationCreator", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  // Indexes are chosen for the two hot queries:
  //   1. "Give me my unread + recent in this workspace"
  //      → (recipientId, readAt) + (recipientId, createdAt DESC)
  //   2. "List all notifications sent in a workspace"
  //      → (workspaceId, createdAt DESC) for the audit view
  // The (workspaceId, recipientId, createdAt) compound is
  // for the panel "show last N across the user's
  // workspaces" query.
  @@index([recipientId, dismissedAt, createdAt(sort: Desc)])
  @@index([recipientId, readAt])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, recipientId, createdAt(sort: Desc)])
  @@index([type])
}

// ============================================================================
// PROCUREMENT / RFQ MODULE
// ============================================================================
//
// Token-based vendor portal: admin builds a MaterialList,
// sends an RFQ to a vendor (one RFQ per vendor, many per list),
// vendor opens a magic link (no login), types prices, and
// submits. We accept a quote and emit a PO.
//
// Money is always Decimal(19,4). Quantities are Decimal(19,4).
// Never float/double.
//
// Pilot vendors: Locke Supply, Broken Arrow Electric.
// Phase-1 project linkage is null (no FK to Project).
// Phase-2 will populate projectId at RFQ-send time.

enum VendorCapability {
  MANUAL // rep types prices into the portal
  QUOTE_LINK // rep has a vendor-side UI, we deep-link
  PUNCHOUT // cXML/OAuth punchout (future)
  API // programmatic pricing (future)
}

enum VendorStatus {
  ACTIVE
  INACTIVE
}

enum MaterialListStatus {
  DRAFT
  QUOTING // RFQs sent, awaiting response
  QUOTED // ≥1 quote in
  CLOSED // a quote was accepted → PO created
}

enum RfqStatus {
  DRAFT
  SENT
  VIEWED
  RESPONDED
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
  // SUPERSEDED: a newer revision exists (this Rfq is a
  // tombstone of a revise-and-resend). Old link on the
  // vendor portal returns a polite "this RFQ has been
  // revised" page with a path to the new revision.
  SUPERSEDED
  // REVOKED: the buyer pulled the RFQ back. The vendor's
  // link shows "this RFQ has been revoked". Permanent
  // — re-sending creates a new Rfq row, doesn't un-revoke.
  REVOKED
}

enum QuoteStatus {
  SUBMITTED
  ACCEPTED
  REJECTED
  SUPERSEDED // a newer revision of the same RFQ replaced this
}

enum PoStatus {
  DRAFT
  PENDING_APPROVAL
  ISSUED
  ACKNOWLEDGED
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

enum PriceSource {
  MANUAL
  QUOTE
  PUNCHOUT
  API
  IMPORT
}

model Vendor {
  id            String           @id @default(cuid())
  workspaceId   String
  name          String
  legalName     String?
  accountNumber String?
  capability    VendorCapability @default(MANUAL)
  status        VendorStatus     @default(ACTIVE)

  phone        String?
  website      String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?

  defaultTerms String?
  taxExempt    Boolean @default(false)
  notes        String?

  // Link to the Subcontractor record if the vendor is
  // also a sub on the same workspace. Optional — a
  // vendor (materials supplier) is not the same thing
  // as a sub (trade contractor), but some companies
  // play both roles.
  subcontractorId String?

  contacts    VendorContact[]
  rfqs        Rfq[]
  quotes      VendorQuote[]
  pos         PurchaseOrder[]
  vendorItems VendorItem[]
  defaultFor  Item[]    @relation("ItemDefaultVendor")
  prices      PriceObservation[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  deletedAt DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
  @@index([workspaceId, status])
  @@index([workspaceId, deletedAt])
}

model VendorContact {
  id          String @id @default(cuid())
  workspaceId String
  vendorId    String
  vendor      Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  name      String
  email     String
  phone     String?
  role      String?
  isPrimary Boolean @default(false)

  rfqs Rfq[] @relation("RfqContact")

  createdAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, vendorId])
  @@index([workspaceId, email])
}

model Item {
  id              String  @id @default(cuid())
  workspaceId     String
  sku             String?
  description     String
  uom             String  @default("EA")
  category        String?
  manufacturer    String?
  mfrPartNumber   String?
  defaultVendorId String?
  active          Boolean @default(true)

  defaultVendor   Vendor? @relation("ItemDefaultVendor", fields: [defaultVendorId], references: [id])
  vendorItems VendorItem[]
  listLines   MaterialListLine[]
  prices      PriceObservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, sku])
  @@index([workspaceId, active])
}

// vendor-specific identity for an internal item
model VendorItem {
  id                String    @id @default(cuid())
  workspaceId       String
  vendorId          String
  vendor            Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  itemId            String
  item              Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  vendorSku         String
  vendorDescription String?
  lastUnitPrice     Decimal?  @db.Decimal(19, 4)
  lastQuotedAt      DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, vendorId, vendorSku])
  @@index([workspaceId, itemId])
}

model MaterialList {
  id          String             @id @default(cuid())
  workspaceId String
  name        String
  status      MaterialListStatus @default(DRAFT)

  // Phase 1: nullable (pilot scope). Phase 2: required at
  // RFQ-send time so committed cost rolls up to a project.
  projectId String?
  costCode  String?

  neededBy  DateTime?
  deliverTo String?
  notes     String?

  lines MaterialListLine[]
  rfqs  Rfq[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  deletedAt DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([workspaceId, projectId])
  @@index([workspaceId, deletedAt])
}

model MaterialListLine {
  id          String       @id @default(cuid())
  workspaceId String
  listId      String
  list        MaterialList @relation(fields: [listId], references: [id], onDelete: Cascade)
  position    Int

  // null = free-text line (no item catalog entry).
  // Free-text lines MUST work — the catalog is optional.
  itemId String?
  item   Item?   @relation(fields: [itemId], references: [id])

  description   String
  manufacturer  String?
  mfrPartNumber String?
  quantity      Decimal @db.Decimal(19, 4)
  uom           String  @default("EA")
  notes         String?

  quoteLines VendorQuoteLine[]

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([listId, position])
  @@index([workspaceId, listId])
}

// RFQ = one vendor's quote request for a material list.
// We send a SEPARATE RFQ per vendor so we can compare
// multiple bids on the same list.
model Rfq {
  id          String @id @default(cuid())
  workspaceId String
  number      String // "RFQ-2026-0001"

  listId      String
  list        MaterialList @relation(fields: [listId], references: [id], onDelete: Cascade)
  vendorId    String
  vendor      Vendor       @relation(fields: [vendorId], references: [id])
  contactId   String?
  contact     VendorContact? @relation("RfqContact", fields: [contactId], references: [id])
  sentToEmail String?

  status RfqStatus @default(DRAFT)

  // Magic-link auth. We store the SHA-256 hash only;
  // the plaintext lives in the outbound email.
  tokenHash     String    @unique
  tokenPrefix   String // first 8 chars, support lookup only
  expiresAt     DateTime
  sentAt        DateTime?
  firstViewedAt DateTime?
  lastViewedAt  DateTime?
  respondedAt   DateTime?
  revokedAt     DateTime?

  message  String?
  neededBy DateTime?

  // ---- REVISION TRACKING ----
  // A revise-and-resend creates a new Rfq row (linked by
  // parentRfqId) and flips this one's status to SUPERSEDED.
  // The vendor's old link is dead but routes to a polite
  // "revised" page that links to the new one.
  parentRfqId String?
  parentRfq   Rfq?   @relation("RfqRevisions", fields: [parentRfqId], references: [id])
  childRfqs   Rfq[]  @relation("RfqRevisions")
  // Sequential per logical RFQ lifetime. The first Rfq
  // is 1, first revision is 2, etc. Stamped on the row +
  // surfaced in the email subject so the vendor can tell
  // "this is RFQ-2026-0001 rev 2" at a glance.
  revision Int @default(1)

  // ---- SOFT DELETE ----
  // Only set on DRAFT RFQs that the buyer deletes. SENT+
  // RFQs are revoked, not deleted, so the audit trail
  // stays intact. Reads filter `deletedAt: null`.
  deletedAt DateTime?

  quotes VendorQuote[]
  events RfqEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, number])
  @@index([workspaceId, status])
  @@index([workspaceId, vendorId])
  @@index([workspaceId, listId])
  @@index([workspaceId, parentRfqId])
  @@index([workspaceId, deletedAt])
}

model RfqEvent {
  id          String @id @default(cuid())
  workspaceId String
  rfqId       String
  rfq         Rfq    @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  // CREATED SENT VIEWED SUBMITTED DECLINED ACCEPTED REVOKED RESENT EXPIRED
  type      String
  actor     String? // clerk userId, or "vendor"
  ipHash    String? // sha256(ip + APP_HASH_SALT) — never raw
  userAgent String?
  meta      Json?
  createdAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, rfqId, createdAt])
  @@index([type])
}

model VendorQuote {
  id          String @id @default(cuid())
  workspaceId String
  rfqId       String
  rfq         Rfq    @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendorId    String
  vendor      Vendor @relation(fields: [vendorId], references: [id])

  status         QuoteStatus @default(SUBMITTED)
  revision       Int         @default(1)
  // client-generated UUID; blocks double-submit on the
  // same RFQ (replay attack or rep's browser double-click).
  idempotencyKey String?     @unique

  vendorReference String?
  respondentName  String?
  respondentEmail String?

  subtotal      Decimal @default(0) @db.Decimal(19, 4)
  taxAmount     Decimal @default(0) @db.Decimal(19, 4)
  freightAmount Decimal @default(0) @db.Decimal(19, 4)
  total         Decimal @default(0) @db.Decimal(19, 4)

  currency     String    @default("USD")
  validUntil   DateTime?
  leadTimeDays Int?
  terms        String?
  notes        String?

  // Private Vercel Blob (signed-URL on read). The
  // URL is a private-blob URL; we never expose it
  // raw to the browser. vendorQuote.attachmentUrl is
  // only ever read by authed staff through the signed
  // URL helper in lib/procurement/attachments.
  attachmentUrl  String?
  attachmentName String?

  lines VendorQuoteLine[]
  po    PurchaseOrder?

  submittedAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, rfqId])
  @@index([workspaceId, vendorId, submittedAt])
  @@index([workspaceId, status])
}

model VendorQuoteLine {
  id          String            @id @default(cuid())
  workspaceId String
  quoteId     String
  quote       VendorQuote       @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  // null for substitutions (the vendor is offering
  // something that wasn't in the original list).
  listLineId  String?
  listLine    MaterialListLine? @relation(fields: [listLineId], references: [id])

  position    Int
  description String
  vendorSku   String?
  quantity    Decimal  @db.Decimal(19, 4)
  uom         String   @default("EA")
  unitPrice   Decimal? @db.Decimal(19, 4)
  lineTotal   Decimal? @db.Decimal(19, 4)

  available    Boolean @default(true)
  leadTimeDays Int?

  // substitution: vendor offers something different
  isSubstitute   Boolean @default(false)
  substituteNote String?

  notes String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, quoteId])
}

model PurchaseOrder {
  id          String @id @default(cuid())
  workspaceId String
  number      String // "PO-2026-0001"

  vendorId String
  vendor   Vendor       @relation(fields: [vendorId], references: [id])
  quoteId  String?      @unique
  quote    VendorQuote? @relation(fields: [quoteId], references: [id])

  // nullable in Phase 1 (pilot scope). Phase 2 makes
  // this effectively required at issue time so the
  // PO rolls up to a project for cost tracking.
  projectId String?
  costCode  String?

  status PoStatus @default(DRAFT)

  subtotal      Decimal @default(0) @db.Decimal(19, 4)
  taxAmount     Decimal @default(0) @db.Decimal(19, 4)
  freightAmount Decimal @default(0) @db.Decimal(19, 4)
  total         Decimal @default(0) @db.Decimal(19, 4)
  currency      String  @default("USD")

  terms    String?
  shipTo   String?
  neededBy DateTime?
  notes    String?

  // ---- DELIVERY ----
  // Where the vendor physically delivers (separate from
  // the vendor's billing address). For construction POs
  // this is usually a jobsite — the vendor is the supplier
  // (Locke, Lowe's) but the delivery point is a specific
  // site address with a foreman/receiver who's the
  // on-site point of contact.
  //
  // deliveryName: e.g. "Main Site — Building A" — short
  //   label the vendor's driver will recognize on the
  //   dispatch sheet.
  // deliveryAddress: full address (one line, free-form;
  //   jobsite addresses don't fit a structured schema).
  // deliveryContactName/Phone/Email: who's at the
  //   delivery site to receive + sign for the load.
  deliveryName           String?
  deliveryAddress        String?
  deliveryContactName    String?
  deliveryContactPhone   String?
  deliveryContactEmail   String?

  // Approval: PM or ADMIN signs off before ISSUED.
  // We store the approver + when for audit; the
  // PENDING_APPROVAL → ISSUED transition is the gate.
  approvedById   String?
  approvedAt     DateTime?
  issuedAt       DateTime?
  issuedBy       String?
  acknowledgedAt DateTime?
  pdfUrl         String?

  lines POLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, number])
  @@index([workspaceId, status])
  @@index([workspaceId, vendorId])
  @@index([workspaceId, projectId])
  @@index([workspaceId, approvedAt])
  // Activity log of everything that happens to a PO.
  // Mirrors the RfqEvent pattern — append-only, with an
  // actor (clerk userId) and a JSON meta blob for
  // event-specific details (line counts, totals, before/
  // after snapshots). Edit PoEvent records use meta to
  // store { added, removed, modified: [lineIds] } so the
  // buyer can see "Bob added 2 lines, removed 1, changed
  // qty on 3" without diffing the line table.
  events PoEvent[]
}

model PoEvent {
  id          String       @id @default(cuid())
  workspaceId String
  poId        String
  po          PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)

  // CREATED EDITED ISSUED RESENT CANCELLED ACKNOWLEDGED RECEIVED CLOSED
  type    String
  actor   String? // clerk userId
  meta    Json?
  createdAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, poId, createdAt])
  @@index([type])
}

model POLine {
  id          String        @id @default(cuid())
  workspaceId String
  poId        String
  po          PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  position    Int
  itemId      String?
  description String
  vendorSku   String?
  quantity    Decimal       @db.Decimal(19, 4)
  uom         String        @default("EA")
  unitPrice   Decimal       @db.Decimal(19, 4)
  lineTotal   Decimal       @db.Decimal(19, 4)
  // A vendor-quote line can be marked as a substitute for the
  // original list line. We carry the note through to the PO
  // so the buyer remembers why this isn't the spec they sent.
  isSubstitute   Boolean @default(false)
  substituteNote String?
  notes          String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, poId])
}

// APPEND-ONLY LEDGER — never update, never delete. This
// is the long-term value of the whole module. Every priced
// quote line writes one row. The "moat" is the history
// we accumulate over time.
model PriceObservation {
  id          String @id @default(cuid())
  workspaceId String

  itemId   String?
  item     Item?   @relation(fields: [itemId], references: [id])
  vendorId String
  vendor   Vendor  @relation(fields: [vendorId], references: [id])

  // denormalised so history survives item/vendor edits
  descriptionSnapshot String
  vendorSkuSnapshot   String?

  unitPrice Decimal  @db.Decimal(19, 4)
  uom       String
  quantity  Decimal? @db.Decimal(19, 4) // qty break matters

  source      PriceSource
  sourceRefId String? // quoteId / poId
  observedAt  DateTime    @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, itemId, observedAt(sort: Desc)])
  @@index([workspaceId, vendorId, observedAt(sort: Desc)])
  @@index([workspaceId, source, observedAt(sort: Desc)])
}

// Race-safe gapless per-workspace/year document numbering.
// Incrementing this in the same transaction as the RFQ/PO
// create guarantees no two docs get the same number even
// under concurrent clicks. The primary key is the
// (workspace, type, period) tuple.
model DocCounter {
  workspaceId String
  docType     String // "RFQ" | "PO"
  period      String // "2026"
  value       Int    @default(0)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, docType, period])
}

// Postgres-backed rate limit. We have no Redis in the
// stack today, and this is fine at the volume we expect
// (a vendor portal doesn't see thousands of req/s).
// A nightly cron purges rows older than 1 day.
model RateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())

  @@index([windowStart])
}
