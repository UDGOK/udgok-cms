  UTILITY
  CUSTOM
}

enum InspectionResult {
  PENDING
  PASSED
  FAILED
  PARTIAL
  CANCELLED
}

model Permit {
  id             String       @id @default(cuid())
  workspaceId    String
  projectId      String
  permitNumber   String? // e.g. "BLD-2026-04812"
  type           String // e.g. "Building", "Electrical", "Plumbing", "Mechanical", "Demolition"
  status         PermitStatus @default(NOT_APPLIED)
  jurisdiction   String? // e.g. "City of Tulsa", "City of Austin"
  appliedDate    DateTime?
  issuedDate     DateTime?
  expirationDate DateTime?
  fee            Decimal?     @db.Decimal(10, 2)
  notes          String?
  createdAt      DateTime     @default(now())
