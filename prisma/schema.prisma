enum PermitStatus {
  NOT_APPLIED
  APPLIED
  ISSUED
  INSPECTION_SCHEDULED
  PASSED
  FAILED
  EXPIRED
  CANCELLED
}

enum InspectionType {
  // Pre-cover / structural
  FOOTING
  FOUNDATION
  SLAB
  // Framing
  FRAMING
  SHEATHING
  // MEP rough
  ROUGH_PLUMBING
