// UDGOK CMS v1 schema
// See docs/superpowers/specs/2026-08-16-handoff-cms-slice-b-design.md section 2 for full spec.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================
// AUTH-SYNCED FROM CLERK (via webhooks)
// Never write to these directly.
// =========================================

model Workspace {
  id        String   @id // == Clerk organization ID
  name      String
  slug      String   @unique
  industry  String?
  plan      Plan     @default(STARTER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members           Membership[]
  clients           Client[]
  deals             Deal[]
  projects          Project[]
  estimates         Estimate[]
  tasks             Task[]
  files             File[]
  teams             Team[]
  subs              Subcontractor[]
  activity          ActivityLog[]
  messages          Message[]
  projectPhotos     ProjectPhoto[]
  permits           Permit[]
  photoFolders      ProjectPhotoFolder[]
  inspections       Inspection[]
  bimModels         BimModel[]
  bimTakeoffs       BimTakeoff[]
  scanEvents        ScanEvent[]
  materials         Material[]
  equipment         Equipment[]
  productCatalog    ProductCatalogItem[]
  siteCheckInCodes  SiteCheckInCode[]
  checkInEvents     CheckInEvent[]
  weeklyTimesheets  WeeklyTimesheet[]
  notifications     Notification[]       @relation("notificationWorkspace")
  vendors           Vendor[]
  vendorContacts    VendorContact[]
  items             Item[]
  vendorItems       VendorItem[]
  materialLists     MaterialList[]
  materialListLines MaterialListLine[]
  rfqs              Rfq[]
  rfqEvents         RfqEvent[]
  vendorQuotes      VendorQuote[]
  vendorQuoteLines  VendorQuoteLine[]
  poEvents          PoEvent[]
  purchaseOrders    PurchaseOrder[]
  polines           POLine[]
  priceObservations PriceObservation[]
  docCounters       DocCounter[]

  @@index([slug])
}

model User {
  id        String   @id // == Clerk user ID
  email     String   @unique
  name      String?
  avatarUrl String?
  // IANA timezone string, e.g. "America/Chicago".
  // When set, the app renders all dates in this
  // timezone instead of the server's (UTC). When
  // null, we fall back to the server timezone.
  // Settings page lets the user pick.
  timezone  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships               Membership[]
  notes                     Note[]
  uploads                   File[]            @relation("uploader")
  assignedTasks             Task[]            @relation("assignee")
  createdTasks              Task[]            @relation("creator")
  messages                  Message[]
  projectPhotos             ProjectPhoto[]
  projectMembers            ProjectMember[]
  teamMembers               TeamMember[]
  activity                  ActivityLog[]
  bimModels                 BimModel[]        @relation("bimUploader")
  scanEvents                ScanEvent[]
  materials                 Material[]        @relation("materialUploader")
  equipment                 Equipment[]       @relation("equipmentUploader")
  siteCheckInCodes          SiteCheckInCode[] @relation("siteCheckInCodeCreator")
  checkInEvents             CheckInEvent[]    @relation("checkInUser")
  checkInEdits              CheckInEvent[]    @relation("checkInEditor")
  weeklyTimesheetsSubmitted WeeklyTimesheet[] @relation("timesheetSubmitter")
  weeklyTimesheetsApproved  WeeklyTimesheet[] @relation("timesheetApprover")
  weeklyTimesheetsRejected  WeeklyTimesheet[] @relation("timesheetRejecter")
  notificationsReceived     Notification[]    @relation("notificationRecipient")
  notificationsCreated      Notification[]    @relation("notificationCreator")
  estimatesCreated          Estimate[]        @relation("estimateCreator")

  @@index([email])
}

model Membership {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String
  role        Role     @default(MEMBER)
  joinedAt    DateTime @default(now())

  // Presence tracking — updated by the /api/presence/heartbeat route.
  // A member is "online" if lastSeenAt is within the past 5 minutes
  // and "idle" if within 60 minutes. Anything older is offline.
  lastSeenAt DateTime?
  isOnline   Boolean   @default(false)

  // IMPORTANT: `user` is `NoAction` (not Cascade) so that when a Workspace
  // is deleted, the cascade can run without trying to delete the User.
  // Users can belong to multiple workspaces; deleting one workspace must
  // not delete the user or their data in other workspaces. The membership
  // row is just deleted; the user remains intact.
  user      User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@index([workspaceId, isOnline])
}

enum Role {
  OWNER
  ADMIN
  PM
  ESTIMATOR
  FIELD
  MEMBER
}

// Subscription tiers. Used to gate premium features across the app.
// When you wire this to Clerk billing later, the `plan` field will be
// synced from the Clerk subscription; the feature flag check
// (lib/workspace/tier.ts) stays the same.
enum Plan {
  STARTER
  PRO
  ENTERPRISE
}

// Entity types a Message can be attached to. We deliberately use a
// small set (no file, no task — too many touch points) so the messages
// UI stays simple. The polymorphic (entityType, entityId) pair points
// at the relevant record; this avoids N junction tables.
enum MessageEntityType {
  PROJECT
  CLIENT
  DEAL
  SUBCONTRACTOR
  PAY_APP
  WORKSPACE
}

// =========================================
// CRM
// =========================================

model Client {
  id          String       @id @default(cuid())
  workspaceId String
  name        String
  email       String?
  phone       String?
  type        ClientType   @default(RESIDENTIAL)
  status      ClientStatus @default(ACTIVE)
  source      String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  properties Property[]
  deals      Deal[]
  projects   Project[]
  estimates  Estimate[]
  tasks      Task[]
  notes      Note[]
  files      File[]

  @@index([workspaceId, status])
  @@index([workspaceId, name])
}

enum ClientType {
  RESIDENTIAL
  COMMERCIAL
  PROPERTY_MANAGER
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model Property {
  id        String  @id @default(cuid())
  clientId  String
  label     String
  address   String
  city      String
  state     String
  zip       String
  yearBuilt Int?
  sqft      Int?
  notes     String?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  deals  Deal[]

  @@index([clientId])
}

model Deal {
  id            String    @id @default(cuid())
  workspaceId   String
  clientId      String
  propertyId    String?
  title         String
  description   String?
  stage         DealStage @default(LEAD)
  value         Decimal   @db.Decimal(12, 2)
  margin        Float?
  expectedClose DateTime?
  closedAt      DateTime?
  fitScore      Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace        Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client           Client     @relation(fields: [clientId], references: [id])
  property         Property?  @relation(fields: [propertyId], references: [id])
  // The project this deal was converted into. null until
  // "Convert to project" is clicked on the deal detail page.
  convertedProject Project?   @relation("DealConversion")
  // Estimates sent to the client during the deal
  // pipeline (when stage=ESTIMATE_SENT). One deal
  // can have many estimates (rev 1, rev 2, etc).
  estimates        Estimate[] @relation("estimateDeal")
  notes            Note[]
  files            File[]
  tasks            Task[]

  @@index([workspaceId, stage])
  @@index([workspaceId, clientId])
}

enum DealStage {
  LEAD
  CONTACTED
  ESTIMATE_SENT
  NEGOTIATING
  WON
  LOST
}

// =========================================
// ESTIMATES — client-facing proposal + approval
// =========================================
//
// An Estimate is a proposal sent to a client. It can
// be standalone (built directly from a client page
// when the client requests a quote) or tied to an
// existing project (a change-order scope) or
// generated from a Deal in the pipeline. The same
// model covers all three cases via the optional
// projectId / dealId fields.
//
// Lifecycle:
//   DRAFT → SENT → VIEWED → APPROVED → CONVERTED
//                 ↘ REJECTED
//   EXPIRED — only set if the admin manually retires
//             the estimate or if the validUntil date
//             passes (we don't auto-set EXPIRED; the
//             UI just shows "Expired" in red).
//
// The shareToken is the credential for the public
// /e/[token] page — same pattern as the pay-app
// share tokens. Anyone with the URL can view; the
// approve / reject actions on the public page take
// a viewerEmail (typed by the user) so we have an
// audit trail of who clicked what.
//
// On APPROVED, the admin can hit "Convert to
// project" in the app. That action creates a new
// Project (with the client + contract value from
// the estimate) and stamps convertedProjectId so
// the estimate closes out. Once converted, the
// project picks up the standard project lifecycle
// (tasks, pay apps, etc.).
//
// Line items live in a child table so the
// estimate has a real breakdown (not just a total)
// and the convert-to-project action can pre-create
// default CSI divisions from the line items if
// the user wants.

model Estimate {
  id                 String  @id @default(cuid())
  workspaceId        String
  clientId           String
  // Optional — null when the estimate is standalone
  // (no existing project context). When set, the
  // estimate is a scope change for that project.
  projectId          String?
  // When the admin selects "Create new project" on
  // the estimate form (instead of "Link to existing"
  // or "None"), we capture the desired name + code
  // up front. On approval → Convert to project, the
  // new Project uses these instead of the estimate
  // title. Both nullable; null = use the legacy path
  // (project name = estimate title, no code).
  pendingProjectName String?
  pendingProjectCode String?
  // Optional — null when the estimate wasn't spawned
  // from a Deal. When set, the Deal's stage moves to
  // ESTIMATE_SENT on send, NEGOTIATING if the client
  // views, WON on approval.
  dealId             String?
  // The token for the public approval URL.
  // Generated server-side; never sent to the client
  // until "Send" is clicked.
  shareToken         String? @unique

  title       String
  description String?
  // The proposal number shown on the PDF / public
  // view, e.g. EST-2026-0142. Auto-generated on create.
  number      String    @unique
  // ISO date string. The estimate is considered
  // expired after this date (the UI shows "Expired"
  // in red; we don't auto-transition status to keep
  // the state machine simple).
  validUntil  DateTime?

  // Money — stored as Decimal for precision. The
  // total is computed as subtotal + taxAmount. We
  // persist the taxAmount + taxRate so the PDF can
  // show the breakdown.
  subtotal  Decimal  @db.Decimal(12, 2)
  taxRate   Decimal? @db.Decimal(5, 4) // 0.0825 = 8.25%
  taxAmount Decimal? @db.Decimal(12, 2)
  total     Decimal  @db.Decimal(12, 2)

  status EstimateStatus @default(DRAFT)

  // Audit timestamps.
  createdById        String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  // When "Send" was clicked. Distinct from createdAt
  // because the admin might draft a quote days before
  // sending it.
  sentAt             DateTime?
  firstViewedAt      DateTime?
  // Approval audit (public page, no auth — the
  // viewerEmail is typed by the client so we have a
  // paper trail of who clicked approve).
  approvedAt         DateTime?
  approvedByEmail    String?
  approvedByName     String?
  // Rejection audit.
  rejectedAt         DateTime?
  rejectedByEmail    String?
  rejectedByName     String?
  rejectNote         String?
  // Set when the admin runs "Convert to project".
  convertedProjectId String?   @unique
  convertedAt        DateTime?

  workspace     Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client        Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project       Project?           @relation("estimateProject", fields: [projectId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  deal          Deal?              @relation("estimateDeal", fields: [dealId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  // The project that was created from this estimate
  // (when convertedProjectId is set). The Project
  // side has the matching "estimateConversion"
  // back-relation.
  sourceProject Project?           @relation("estimateConversion", fields: [convertedProjectId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdBy     User               @relation("estimateCreator", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: Cascade)
  lineItems     EstimateLineItem[]

  @@index([workspaceId, status])
  @@index([workspaceId, clientId])
  @@index([workspaceId, projectId])
  @@index([clientId])
}

enum EstimateStatus {
  // Admin is still building the quote. Not visible
  // to the client.
  DRAFT
  // Admin clicked Send. shareToken is live; the
  // public URL is shareable. The line items are
  // locked from edits (a new estimate must be sent
  // instead of mutating the old one — keeps the
  // audit trail clean).
  SENT
  // Client opened the public URL. firstViewedAt
  // is set. Admin sees "Viewed" in the list.
  VIEWED
  // Client clicked Approve. The estimate is locked;
  // the only remaining action is "Convert to project"
  // (or "Void" if the admin wants to discard).
  APPROVED
  // Client clicked Reject. The estimate is closed;
  // a new estimate would need to be drafted to
  // re-engage.
  REJECTED
  // Admin ran "Convert to project". The estimate
  // is closed and the project is now active. The
  // convertedProjectId field points at the new
  // project.
  CONVERTED
}

// Line items on an estimate. Description + quantity
// + unit price = line total. We persist the line
// total so the PDF doesn't have to re-compute on
// every render and so the convert-to-project
// action has the per-line numbers available.
model EstimateLineItem {
  id           String  @id @default(cuid())
  estimateId   String
  // Order on the estimate (1, 2, 3, ...). Drives
  // the render order; users can re-order later.
  position     Int
  // Optional CSI division code (e.g. "09 30 00"
  // for tile). The convert-to-project action uses
  // this to seed the project's default divisions.
  divisionCode String?
  description  String
  quantity     Decimal @db.Decimal(10, 2)
  // Unit shorthand (EA, SF, LF, HR, LS, etc.). Free
  // text so the user can record any unit they bought
  // (board-feet, cubic-yard, pallet, etc.).
  unit         String  @default("EA")
  unitPrice    Decimal @db.Decimal(12, 2)
  // quantity * unitPrice, persisted for fast PDF
  // generation + convert-to-project.
  lineTotal    Decimal @db.Decimal(12, 2)

  estimate Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@index([estimateId, position])
}

model Note {
  id        String   @id @default(cuid())
  authorId  String
  body      String
  clientId  String?
  dealId    String?
  projectId String?
  createdAt DateTime @default(now())

  author  User     @relation(fields: [authorId], references: [id], onDelete: NoAction, onUpdate: Cascade)
  client  Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  deal    Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([dealId])
  @@index([projectId])
}

// =========================================
// PROJECTS (core in v1; full pay app in v1 too)
// =========================================

model Project {
  id              String        @id @default(cuid())
  workspaceId     String
  clientId        String?
  // Set when this project was created from a Won deal. One
  // deal → at most one project (enforced by the @unique below).
  // OnDelete: SetNull so deleting a deal doesn't cascade-delete
  // the project — the project stands on its own.
  dealId          String?       @unique
  name            String
  code            String?
  description     String?
  status          ProjectStatus @default(ACTIVE)
  startDate       DateTime?
  endDate         DateTime?
  contractValue   Decimal?      @db.Decimal(12, 2)
  address         String?
  city            String?
  state           String?
  zip             String?
  // Geocoded coordinates. Auto-populated by the geocoder when address
  // changes, but can be manually overridden (set geocodeSource='manual').
  // Used by the Site Map / Project MAP features.
  latitude        Float?
  longitude       Float?
  geocodedAt      DateTime?
  geocodeSource   String? // 'nominatim' | 'manual' | 'mapbox' | 'cached'
  geocodedAddress String? // the address that was actually geocoded (for cache invalidation)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  workspace        Workspace                        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client           Client?                          @relation(fields: [clientId], references: [id])
  deal             Deal?                            @relation("DealConversion", fields: [dealId], references: [id], onDelete: SetNull)
  members          ProjectMember[]
  tasks            Task[]
  files            File[]
  notes            Note[]
  divisions        ProjectDivision[]
  payApps          PayApp[]
  subAssignments   ProjectSubcontractorAssignment[]
  photos           ProjectPhoto[]
  photoFolders     ProjectPhotoFolder[]
  permits          Permit[]
  bimModels        BimModel[]
  bimTakeoffs      BimTakeoff[]
  materials        Material[]
  equipment        Equipment[]
  siteCheckInCodes SiteCheckInCode[]
  checkInEvents    CheckInEvent[]
  // Estimates created for this project (scope changes
  // or change orders). null when the project was
  // created from a Won deal (the deal is the source
  // of the original scope) and no follow-on
  // estimates have been drafted.
  estimates        Estimate[]                       @relation("estimateProject")
  // The estimate that was approved and converted
  // into this project. Inverse of
  // Estimate.convertedProjectId. At most one
  // estimate can convert into a project — enforced
  // by @unique on convertedProjectId.
  sourceEstimate   Estimate?                        @relation("estimateConversion")

  @@index([workspaceId, status])
  @@index([workspaceId, clientId])
  @@index([workspaceId, latitude, longitude])
}

// =========================================
// INVENTORY — materials and equipment per project
// =========================================

/**
 * Building materials tracked per project. The `code` field is
 * the barcode/UPC/SKU that gets scanned — uniqueness is scoped
 * to (workspaceId, projectId, code) so the same SKU can be
 * tracked separately for two different projects (e.g., 50
 * sheets of drywall on Job A, 30 sheets on Job B). This is
 * what the scan page links to when a code is recognized.
 * `unit` is a free-text string (each, board-feet, linear-feet,
 * square-feet, cubic-yard, pound, gallon, etc.) — we don't
 * constrain it because construction has a million units and
 * the user knows what they bought.
 * `quantity` is the current on-hand count. Decremented as the
 * material is consumed on site; incremented as deliveries
 * arrive. We don't track every movement here (that's a future
 * feature) — just the current balance.
 */
model Material {
  id               String   @id @default(cuid())
  workspaceId      String
  projectId        String
  uploaderId       String
  code             String // barcode / UPC / SKU / QR value
  name             String
  description      String?
  unit             String   @default("each")
  unitCost         Decimal? @db.Decimal(12, 2)
  quantity         Decimal  @default(0) @db.Decimal(12, 2)
  // Vendor info — captured at scan time so a foreman
  // re-scanning a delivery knows the supplier without
  // re-typing it. Per-project (the same drywall might come
  // from Home Depot on one job and from a local yard on
  // another), so these are columns on Material, not on
  // ProductCatalogItem.
  //
  // - vendor: free-text supplier name ("Home Depot", "Acme
  //   Lumber Co.")
  // - vendorPartNumber: the vendor's own SKU (different from
  //   the universal UPC/EAN we already store in `code`)
  // - vendorContact: free-text phone/email/contact name
  vendor           String?
  vendorPartNumber String?
  vendorContact    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader  User      @relation("materialUploader", fields: [uploaderId], references: [id], onDelete: NoAction, onUpdate: Cascade)

  @@unique([workspaceId, projectId, code], name: "material_code_per_project")
  @@index([workspaceId, projectId])
  @@index([workspaceId, code])
  // Vendor index — the project INVENTORY tab's "filter by
  // vendor" feature hits this so a workspace with hundreds of
  // materials on a job doesn't have to scan the whole table.
  @@index([workspaceId, projectId, vendor])
}

/**
 * Tools and equipment tracked per project. Same shape as
 * Material (code, project-scoping, current quantity) plus a
 * `condition` enum (NEW, GOOD, FAIR, POOR) so the team can
 * track what's worn out. Serial number is captured separately
 * from the barcode — a piece of equipment can have both, and
 * some have neither.
 */
model Equipment {
  id           String             @id @default(cuid())
  workspaceId  String
  projectId    String
  uploaderId   String
  code         String
  name         String
  description  String?
  serialNumber String?
  condition    EquipmentCondition @default(GOOD)
  unitCost     Decimal?           @db.Decimal(12, 2)
  quantity     Int                @default(1)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader  User      @relation("equipmentUploader", fields: [uploaderId], references: [id], onDelete: NoAction, onUpdate: Cascade)

  @@unique([workspaceId, projectId, code], name: "equipment_code_per_project")
  @@index([workspaceId, projectId])
  @@index([workspaceId, code])
}

enum EquipmentCondition {
  NEW
  GOOD
  FAIR
  POOR
}

// =========================================
// PRODUCT CATALOG — workspace-scoped barcode cache
// =========================================

/**
 * Master catalog of products that have been seen in this
 * workspace. We don't ship a product database with the CMS —
 * we use online APIs (UPCitemdb, Open Food Facts) on cache miss
 * and persist the result here. Future scans of the same
 * barcode hit the local DB, no API call needed.
 * Scope is workspace-wide: every project in a workspace
 * shares the same catalog. A drywall SKU used on three jobs
 * is one row here, three rows in `Material` (one per job).
 * `source` records where the data came from:
 * - 'upcitemdb' — UPCitemdb trial API (general-purpose, works
 * for most consumer products including construction supplies)
 * - 'openfoodfacts' — Open Food Facts (food products only,
 * richer nutrition data)
 * - 'manual' — user typed in the details by hand
 * `lastFetchedAt` is bumped every time we re-validate against
 * the online source. If the source data changes, we update
 * the row rather than create a duplicate. (A barcode is
 * globally unique per product, so uniqueness on
 * (workspaceId, code) makes sense.)
 */
model ProductCatalogItem {
  id             String   @id @default(cuid())
  workspaceId    String
  code           String // barcode (UPC, EAN, QR-encoded SKU, etc.)
  name           String
  description    String?
  brand          String?
  // Vendor / supplier for this product. Populated from
  // UPCitemdb's `brand` field (and Open Food Facts' `brands`
  // field) on the first successful online lookup. We keep it
  // separate from `brand` because a UPC can be branded by one
  // company but supplied by another (private-label goods).
  // The Material.vendor field is per-project and is what the
  // user sees on the INVENTORY tab; this column is the
  // workspace-wide cache used to pre-fill the form on a
  // re-scan.
  vendor         String?
  manufacturer   String?
  category       String?
  imageUrl       String?
  source         String // 'upcitemdb' | 'openfoodfacts' | 'manual'
  sourceMetadata Json? // the full API response for debugging / future use
  lastFetchedAt  DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, code], name: "product_per_workspace")
  @@index([workspaceId, name])
}

// Per-construction-phase photos. Categorized by:
//   - room (free text: "Kitchen", "Master Bath", "Lobby")
//   - area (free text: "North wing", "Floor 2")
//   - phase: ROUGH_IN (framing/electrical/plumbing before drywall)
//          or FINAL (completed work, post-drywall/paint/finish)
//
// Foremen can snap a "rough-in" photo at the right phase and the
// project owner sees it instantly. The "phase" toggle in the gallery
// filters to just rough-in or just final photos, so you can compare
// before/after.
model ProjectPhotoFolder {
  id          String   @id @default(cuid())
  workspaceId String
  projectId   String
  name        String // e.g. "Punch List", "Before", "Foundation", "MEP"
  description String?
  color       String   @default("orange") // css color name: orange, ink, success, etc.
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  photos    ProjectPhoto[]

  @@unique([projectId, name])
  @@index([projectId, sortOrder])
}

model ProjectPhoto {
  id          String     @id @default(cuid())
  workspaceId String
  projectId   String
  uploaderId  String
  folderId    String?
  url         String // Vercel Blob URL
  filename    String
  mimeType    String
  size        Int
  room        String? // e.g. "Kitchen", "Master Bath"
  area        String? // e.g. "North wing", "Floor 2"
  phase       PhotoPhase @default(ROUGH_IN)
  caption     String?
  latitude    Float?
  longitude   Float?
  takenAt     DateTime?
  createdAt   DateTime   @default(now())

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader  User                @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  folder    ProjectPhotoFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([projectId, phase, createdAt])
  @@index([projectId, room])
  @@index([workspaceId, createdAt])
}

enum PhotoPhase {
  ROUGH_IN
  FINAL
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

// =========================================
// PERMITS & INSPECTIONS
